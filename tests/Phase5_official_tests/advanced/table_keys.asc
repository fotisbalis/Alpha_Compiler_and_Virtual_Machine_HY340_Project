/*
 * ADVANCED / BONUS -- table keys of every type
 * The default key types are numbers and strings. As a bonus this VM also allows
 * booleans, library functions and user functions to be used as keys. This test
 * stores one value under a key of each type and reads them all back.
 *
 * Expected output:
 *   number key 42  : answer
 *   string key k   : value-k
 *   bool key true  : yes
 *   bool key false : no
 *   libfunc key    : built-in print
 *   userfunc key   : my function
 *   true and false are distinct keys: true
 *   total distinct keys: 6
 */

function myFunc() { return 0; }

t = [
	{ 42      : "answer"        },
	{ "k"     : "value-k"       },
	{ true    : "yes"           },
	{ false   : "no"            },
	{ print   : "built-in print"},
	{ myFunc  : "my function"   }
];

print("number key 42  : ", t[42], "\n");
print("string key k   : ", t["k"], "\n");
print("bool key true  : ", t[true], "\n");
print("bool key false : ", t[false], "\n");
print("libfunc key    : ", t[print], "\n");
print("userfunc key   : ", t[myFunc], "\n");

// true and false really index different slots.
distinct = t[true] != t[false];
print("true and false are distinct keys: ", distinct, "\n");

print("total distinct keys: ", objecttotalmembers(t), "\n");
