/*
 * BASIC / short-circuit evaluation (feature / deduction check)
 * Targets: 'or' must stop as soon as its left operand is true. foo() returns a
 * truthy value, so bar() must NEVER be called -- its "Hello" must not appear.
 *
 * Expected output (short-circuit implemented):
 *   MarvelousWorld
 *
 * Wrong output (short-circuit NOT implemented -- both operands evaluated):
 *   MarvelousHelloWorld
 */

function foo(){
	print("Marvelous");
	return 1;
}

function bar(){
	print("Hello");
	return 1;
}


if (foo() or bar()) {
	print("World\n");
}
