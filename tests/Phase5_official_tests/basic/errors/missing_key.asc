/*
 * BASIC ERROR / reading a table key that does not exist
 * Expected: runtime error -> "Table ... does not have an element with index".
 * In this VM, reading an absent key is fatal (it is not silently nil).
 */
t = [10, 20, 30];
print("table has ", objecttotalmembers(t), " elements; about to read index 99\n");
print("value: ", t[99], "\n");
print("this line must never run\n");
