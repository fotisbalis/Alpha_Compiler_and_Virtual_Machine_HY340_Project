/*
 * BASIC ERROR / '==' between two different (non-bool, non-nil) types
 * Expected: runtime error -> "Cannot compare different types".
 * (bool and nil have special coercions; number vs string does not.)
 */
n = 5;
s = "5";
print("about to compare number == string\n");
if (n == s)
	print("this line must never run\n");
